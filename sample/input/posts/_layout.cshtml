<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@Document.GetString("Title", Document.GetString("SiteTitle", "Sample"))</title>
        @RenderSection("head", required: false)
    </head>
    <body>
        <div class="container mt-4">
            <main>
                @RenderBody()
            </main>
        </div>
        @Html.Partial("_partials/_footer")
    </body>
</html>